rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /pending-builds/{fileName} {
      allow read: if false;
      allow write: if request.auth != null;
    }

    match /simulations/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
